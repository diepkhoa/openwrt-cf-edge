#!/bin/sh /etc/rc.common
# Copyright (C) 2026 diepkhoa

START=95
STOP=10
USE_PROCD=1

PROG="/usr/bin/cf-edge"
CONF="/etc/cf-edge/config.yaml"

start_service() {
	[ -x "$PROG" ] || return 1
	[ -f "$CONF" ] || return 1
	"$PROG" validate -c "$CONF" >/dev/null || return 1

	procd_open_instance
	procd_set_param command cf-edge daemon
	procd_set_param env GOMEMLIMIT=32MiB
	procd_set_param file "$CONF"
	procd_set_param respawn "${respawn_threshold:-3600}" "${respawn_timeout:-5}" "${respawn_retry:-5}"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "network"
}
